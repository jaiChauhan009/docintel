# ---------------------------------------------------------------------------
# DocIntel configuration. Copy to `.env` and adjust as needed.
# docker-compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- App ---
ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma separated list of allowed CORS origins for the dashboard
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ---
# CHANGE THIS in any real deployment. Used to sign JWTs.
JWT_SECRET=dev-super-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=1440

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=15
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff,text/plain

# --- Rate limiting (per API key / per user, fixed window) ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- PostgreSQL ---
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docintel-documents
S3_FORCE_PATH_STYLE=true

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_DOCUMENT_TOPIC=document.processing
KAFKA_CONSUMER_GROUP=docintel-workers

# --- OCR ---
# tesseract | plaintext  (plaintext just reads .txt files verbatim; handy for demos)
OCR_PROVIDER=tesseract
OCR_TIMEOUT_SECONDS=60
OCR_LANGUAGES=eng

# --- LLM ---
# fake | openai   (fake returns deterministic extractions, no network / no cost)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-not-needed-for-fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# --- Processing / retries ---
MAX_PROCESSING_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=2

# --- Webhooks ---
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=2
WEBHOOK_TIMEOUT_SECONDS=10
